<odoo>
  <record model="ir.ui.view" id="res_config_settings_view_form">
    <field name="model">res.config.settings</field>
    <field name="priority" eval="95" />
    <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//div[@id='pos_interface_section']" position="inside">
        <div class="col-12 col-lg-6 o_setting_box">
          <div class="o_setting_left_pane">
            <field name="pos_config_product_restrict_available_warehouse" />
          </div>
          <div class="o_setting_right_pane">
            <label for="pos_config_product_restrict_available_warehouse" />
            <div
                            class="text-muted"
                            attrs="{'invisible': [('pos_config_product_restrict_available_warehouse', '=', False)]}"
                        >
                Product which are not available in selected warehouses won't be displayed in the PoS.
            </div>
            <field
                            name="pos_config_product_available_warehouse_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                            attrs="{'invisible': [('pos_config_product_restrict_available_warehouse', '=', False)]}"
                        />
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
